{
  "name": "testtriple",
  "version": "3.1.1",
  "description": "A handy little mocking library inspired by testdouble and @fluffy-spoon/substitute",
  "main": "lib/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc && rm lib/*.spec.js && rm -r lib/test-utils",
    "clean": "rm -rdf lib && rm -f testtriple-*.tgz",
    "prepack": "npm run test && npm run clean && npm run build"
  },
  "homepage": "https://github.com/VanCoding/testtriple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanCoding/testtriple.git"
  },
  "files": [
    "/lib",
    "/package.json"
  ],
  "keywords": [
    "typescript",
    "testdouble",
    "substitute",
    "mock",
    "mocking",
    "test",
    "testing",
    "tdd",
    "stub",
    "spy",
    "faking"
  ],
  "author": {
    "name": "Patrik Stutz",
    "email": "patrik.stutz@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
