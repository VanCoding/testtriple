{
  "name": "testtriple",
  "version": "4.0.0-preview.1",
  "description": "A handy little mocking library inspired by testdouble and @fluffy-spoon/substitute",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "tsc --noEmit &&vitest run",
    "build": "tsdown src/index.ts --format cjs,esm --dts --out-dir lib --clean",
    "clean": "rm -rdf lib && rm -f testtriple-*.tgz",
    "prepack": "npm run test && npm run clean && npm run build"
  },
  "homepage": "https://github.com/VanCoding/testtriple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanCoding/testtriple.git"
  },
  "files": [
    "/lib",
    "/package.json"
  ],
  "keywords": [
    "typescript",
    "testdouble",
    "substitute",
    "mock",
    "mocking",
    "test",
    "testing",
    "tdd",
    "stub",
    "spy",
    "faking"
  ],
  "author": {
    "name": "Patrik Stutz",
    "email": "patrik.stutz@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
